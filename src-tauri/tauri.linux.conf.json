{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flo",
        "dragDropEnabled": false,
        "width": 1220,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "transparent": false,
        "decorations": true,
        "backgroundColor": "#f4f6fb"
      }
    ]
  },
  "bundle": {
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "section": "utils",
        "files": {
          "/usr/share/metainfo/com.flo.flow.metainfo.xml": "linux/com.flo.flow.metainfo.xml"
        },
        "depends": [
          "libxdo3",
          "libasound2t64 | libasound2",
          "libpipewire-0.3-0t64 | libpipewire-0.3-0",
          "libdbus-1-3",
          "libxtst6",
          "libgbm1",
          "libegl1",
          "libxcb1",
          "libxrandr2"
        ],
        "recommends": [
          "pulseaudio-utils",
          "xdg-desktop-portal",
          "gnome-keyring | kwalletmanager | keepassxc"
        ]
      }
    }
  }
}
