{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flo",
  "version": "0.1.6",
  "identifier": "com.flo.flow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Flo",
        "dragDropEnabled": false,
        "width": 1220,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": [
            "sidebar",
            "mica"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Flo, your assistant: voice dictation, meeting notes and to-dos.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "flo"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGODNCRjMzOEQyMkJFNTQKUldSVXZpS05NNytEN3hKaFV5ekFQbFR2WVR3MlU3akhrVXVxbnMvWGVRQ2R2MTZVaVhZdEhmaWYK",
      "endpoints": []
    }
  }
}
