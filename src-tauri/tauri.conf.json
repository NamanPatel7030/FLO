{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flo",
  "version": "0.1.8",
  "identifier": "com.flo.flow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Flo",
        "dragDropEnabled": false,
        "width": 1220,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": [
            "sidebar",
            "mica"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Talk, and it's typed. Voice dictation, meeting notes and to-dos.",
    "longDescription": "Flo turns your voice into clean text in any app. Hold a key, speak in English, Hindi or Hinglish, and Flo types it where your cursor is. Speech to text runs on your own computer and works offline. Flo also takes meeting notes with speakers, collects to-dos from your screen, Slack and Gmail, and answers questions from a small pill on your screen.",
    "publisher": "Naman Patel",
    "copyright": "Copyright 2026 Naman Patel",
    "homepage": "https://flo.hellonaman.com",
    "license": "LicenseRef-proprietary",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "flo"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGODNCRjMzOEQyMkJFNTQKUldSVXZpS05NNytEN3hKaFV5ekFQbFR2WVR3MlU3akhrVXVxbnMvWGVRQ2R2MTZVaVhZdEhmaWYK",
      "endpoints": []
    }
  }
}
