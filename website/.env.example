# ── Flo website environment ──────────────────────────────────────────────
# Copy to .env.local for local dev; set the same keys in Vercel (Project → Settings → Environment
# Variables) for production. Full walkthrough: docs/supabase-setup.md

# Public site URL (no trailing slash). Production: https://flo.hellonaman.com  Local: http://localhost:3000
# Used for Supabase email / Google redirect links (${SITE_URL}/auth/callback) and the Slack callback.
SITE_URL=http://localhost:3000

# ── Supabase (Auth + Postgres) ───────────────────────────────────────────
# Supabase dashboard → Project Settings → API. Both are public (they ship to the browser).
# The anon key may be the legacy "anon" JWT or the new publishable key (sb_publishable_…).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Postgres connection for the private `app` schema and profiles.
# Supabase dashboard → Connect → "Transaction pooler" (port 6543), with your database password:
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Never expose this to the browser (no NEXT_PUBLIC_ prefix).
DATABASE_URL=
# Optional: max connections per server instance (default 5).
# DATABASE_POOL_MAX=5

# Signs the desktop app's tokens (30-day JWTs), seals Slack handoffs and keys device/pair-code hashes.
# Generate: openssl rand -base64 32   (changing it signs every desktop app out)
AUTH_SECRET=

# ── One-click "Connect Slack" in the app (docs/slack-setup.md) ───────────
# Create the Slack app from slack-app-manifest.yml, then paste its Client ID / Secret.
# Redirect URL: ${SITE_URL}/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Phone push (docs/mobile-api.md) ──────────────────────────────────────
# Firebase service account JSON (the JSON itself), or a path to the file.
FCM_SERVICE_ACCOUNT=
# FCM_SERVICE_ACCOUNT_FILE=

# ── Installer locations (GitHub Releases, Supabase Storage, /releases/...) ──
# Server-only: the site never shows these URLs; it serves downloads through /api/download/<os>,
# which requires a signed-in account.
DOWNLOAD_MAC=
DOWNLOAD_WINDOWS=
DOWNLOAD_LINUX=
