# ── Flo website environment ──────────────────────────────────────────────
# Copy to .env.local for local dev; set the same keys in your host (Vercel) for production.

# Public site URL (no trailing slash). Local: http://localhost:3000
SITE_URL=http://localhost:3000

# NextAuth session secret. Generate: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (console.cloud.google.com → APIs & Services → Credentials → OAuth client, type Web).
# Authorized redirect URI: ${SITE_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Database. Local dev needs nothing (defaults to file:./flo.db).
# Production: create a Turso DB (turso.tech) → `turso db create flo` → `turso db show flo --url`
#            and `turso db tokens create flo`.
DATABASE_URL=file:./flo.db
DATABASE_AUTH_TOKEN=

# Download links shown on /download once the installers are built (GitHub Releases, etc.)
NEXT_PUBLIC_DOWNLOAD_MAC=
NEXT_PUBLIC_DOWNLOAD_WINDOWS=
NEXT_PUBLIC_DOWNLOAD_LINUX=
